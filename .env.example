# Parallel configuration. Copy to .env and edit. Every setting is optional for local development
# except where noted; production deployments must set the secrets marked REQUIRED.
# Settings are read from PARALLEL_* environment variables (packages/core/src/parallel_core/settings.py).

# ---------------------------------------------------------------- deployment
# development | test | production. Production refuses to start with a weak secret key.
PARALLEL_ENVIRONMENT=development
# REQUIRED in production: a random value of at least 32 characters, for example the output of
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# It signs session tokens and asset download URLs. Rotating it signs everyone out.
PARALLEL_SECRET_KEY=dev-insecure-change-me-not-for-production
# Where the browser reaches the application (used in signed download URLs and CORS).
PARALLEL_PUBLIC_BASE_URL=http://localhost:8000
PARALLEL_WEB_ORIGIN=http://localhost:5173

# ---------------------------------------------------------------- database and queue
# Local development connects to localhost; compose.yaml overrides these for the containers.
PARALLEL_DATABASE_URL=postgresql+psycopg://parallel:parallel@localhost:5432/parallel
PARALLEL_REDIS_URL=redis://localhost:6379/0
# REQUIRED for compose.yaml: the PostgreSQL password for the bundled database container.
POSTGRES_PASSWORD=change-me

# ---------------------------------------------------------------- authentication
# local (email and password) or oidc (tokens from your identity provider).
PARALLEL_AUTH_MODE=local
# PARALLEL_OIDC_ISSUER=https://login.example.org/
# PARALLEL_OIDC_AUDIENCE=parallel
# PARALLEL_OIDC_JWKS_URL=https://login.example.org/.well-known/jwks.json
PARALLEL_ACCESS_TOKEN_MINUTES=720
# Open access: when true, nobody has to sign in. A request without a token is served as one shared, limited guest
# in a sandbox organisation (see docs/deployment.md, "Open access"). Off by default; never use it for real data.
# PARALLEL_OPEN_ACCESS=false
# PARALLEL_OPEN_ACCESS_MAX_UPLOAD_BYTES=314572800
# PARALLEL_OPEN_ACCESS_STORAGE_CAP_BYTES=5368709120
# PARALLEL_OPEN_ACCESS_MAX_ACTIVE_RECONSTRUCTIONS=2

# ---------------------------------------------------------------- storage
# local (a directory or shared volume) or s3 (any S3-compatible object store).
PARALLEL_STORAGE_BACKEND=local
# PARALLEL_STORAGE_ROOT=/data/storage
# PARALLEL_S3_ENDPOINT_URL=https://s3.eu-west-2.amazonaws.com
# PARALLEL_S3_BUCKET=parallel
# PARALLEL_S3_REGION=eu-west-2
# PARALLEL_S3_ACCESS_KEY_ID=
# PARALLEL_S3_SECRET_ACCESS_KEY=
# Lifetime of signed download URLs, in seconds.
PARALLEL_SIGNED_URL_SECONDS=900

# ---------------------------------------------------------------- limits and quotas
PARALLEL_MAX_UPLOAD_BYTES=4294967296
PARALLEL_MAX_ARCHIVE_TOTAL_BYTES=8589934592
PARALLEL_ORG_CONCURRENT_RUN_LIMIT=8
PARALLEL_ORG_MONTHLY_RUN_QUOTA=5000

# ---------------------------------------------------------------- jobs and engines
# PARALLEL_WORKSPACE_ROOT=/data/workspaces
# Isolated per-engine Python environments created by scripts/setup_runtimes.sh.
# PARALLEL_RUNTIMES_DIR=/app/.runtimes
# Seconds without a worker heartbeat before a run is recovered (requeued or failed).
PARALLEL_HEARTBEAT_TIMEOUT_S=120
PARALLEL_MAX_RUN_ATTEMPTS=2
# Concurrency of the simulation worker container in compose.yaml.
PARALLEL_SIM_CONCURRENCY=2
# Engine installations outside the default paths:
# PARALLEL_OPENFOAM_DIR=/usr/share/openfoam
# PARALLEL_FDS_BIN=/opt/fds/bin/fds
# PARALLEL_ENERGYPLUS_BIN=/usr/local/EnergyPlus-25-2-0/energyplus
# Isaac Sim's python.sh on an RTX GPU worker (the 'gpu' queue).
# PARALLEL_ISAACSIM_PYTHON=/isaac-sim/python.sh
# Threads each engine process may use (OMP_NUM_THREADS and similar).
PARALLEL_ENGINE_THREADS=2

# ---------------------------------------------------------------- AI assistant (optional)
# Every modelling and simulation workflow works without the assistant.
# anthropic | gemini | disabled. Without an API key the assistant reports itself unavailable.
PARALLEL_ASSISTANT_PROVIDER=anthropic
# PARALLEL_ANTHROPIC_API_KEY=
PARALLEL_ASSISTANT_MODEL=claude-opus-5-5
# To use Gemini instead (see docs/assistant-providers.md): set the provider to gemini and
# PARALLEL_GEMINI_API_KEY=
# PARALLEL_GEMINI_MODEL=gemini-2.5-pro
# A free Google AI Studio key may allow Google to use prompts to improve its products: do not use it for
# confidential projects. The organisation must also enable the assistant (Organisation settings).
PARALLEL_ASSISTANT_EFFORT=medium
